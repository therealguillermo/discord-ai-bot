{
  "name": "discord-bot-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Discord bot controlled by a Claude tool-use agent",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "node scripts/run.mjs dev",
    "start": "node scripts/run.mjs start",
    "rebuild:native": "node scripts/rebuild-native.mjs",
    "postinstall": "node scripts/rebuild-native.mjs",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "import:legacy": "tsx scripts/import-legacy-economy.ts",
    "gen:endpoints": "tsx scripts/gen-endpoints.ts",
    "models": "tsx scripts/list-models.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "@discordjs/opus": "^0.10.0",
    "@discordjs/rest": "^2.4.0",
    "@discordjs/voice": "^0.19.0",
    "@napi-rs/canvas": "^1.0.10",
    "@snazzah/davey": "^0.1.12",
    "ajv": "^8.20.0",
    "discord-api-types": "^0.37.100",
    "discord.js": "^14.16.3",
    "dotenv": "^16.4.5",
    "opusscript": "^0.0.8",
    "sodium-native": "^5.1.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.9"
  }
}
