# ============================================================
# SECRETS (never commit the real .env file)
# ============================================================

# Anthropic API key from https://console.anthropic.com
ANTHROPIC_API_KEY=

# Discord bot token (Developer Portal > your app > Bot > Reset Token)
DISCORD_BOT_TOKEN=

# ============================================================
# WHICH DISCORD (server) AND APP
# ============================================================

# Application ID (Developer Portal > General Information)
DISCORD_APP_ID=
# The ONE server this bot will act in. Enable Developer Mode in Discord, then
# right-click the server icon > Copy Server ID.
DISCORD_GUILD_ID=

# ============================================================
# WHO CAN USE THE AGENT (the owner is always allowed)
# ============================================================

# Your Discord user ID (right-click your name > Copy User ID)
OWNER_USER_ID=
# Optional: extra users, comma-separated user IDs
ALLOWED_USER_IDS=
# Optional: roles whose members may use the agent, comma-separated role IDs
# (Server Settings > Roles > right-click a role > Copy Role ID)
ALLOWED_ROLE_IDS=

# ============================================================
# WHICH CHANNELS IT RESPONDS IN
# ============================================================

# Optional: comma-separated channel IDs. Empty = any channel in the server.
# Threads inherit permission from their parent channel.
# (right-click a channel > Copy Channel ID)
ALLOWED_CHANNEL_IDS=

# ============================================================
# MODEL AND LIMITS
# ============================================================

# Model used by the agent (set to any model your key can access)
ANTHROPIC_MODEL=claude-sonnet-4-5
MAX_AGENT_ITERATIONS=15
MAX_OUTPUT_TOKENS=4096
HISTORY_WINDOW=20
# Total tokens (input + output, across all loop iterations) allowed for one request
MAX_TURN_TOKENS=300000
