# ============================================================
# SECRETS (never commit the real .env file)
# ============================================================

# Anthropic API key from https://console.anthropic.com
ANTHROPIC_API_KEY=

# Discord bot token (Developer Portal > your app > Bot > Reset Token)
DISCORD_BOT_TOKEN=

# ============================================================
# WHICH DISCORD (server) AND APP
# ============================================================

# Application ID (Developer Portal > General Information)
DISCORD_APP_ID=
# The ONE server this bot will act in. Enable Developer Mode in Discord, then
# right-click the server icon > Copy Server ID.
DISCORD_GUILD_ID=

# ============================================================
# WHO CAN USE THE AGENT (the owner is always allowed)
# ============================================================

# Your Discord user ID (right-click your name > Copy User ID)
OWNER_USER_ID=
# Optional: extra users, comma-separated user IDs
ALLOWED_USER_IDS=
# Optional: roles whose members may use the agent, comma-separated role IDs
# (Server Settings > Roles > right-click a role > Copy Role ID)
ALLOWED_ROLE_IDS=

# ============================================================
# WHICH CHANNELS IT RESPONDS IN
# ============================================================

# Optional: comma-separated channel IDs. Empty = any channel in the server.
# Threads inherit permission from their parent channel.
# (right-click a channel > Copy Channel ID)
ALLOWED_CHANNEL_IDS=

# ============================================================
# MODEL AND LIMITS
# ============================================================

# Model used by the agent. Run "npm run models" to list the IDs your key can use.
ANTHROPIC_MODEL=claude-sonnet-5
MAX_AGENT_ITERATIONS=15
MAX_OUTPUT_TOKENS=4096
HISTORY_WINDOW=20
# Total tokens (input + output, across all loop iterations) allowed for one request
MAX_TURN_TOKENS=300000

# ============================================================
# FEATURES (economy, games, moderation, images, music) — all via the agent
# ============================================================

# Where the economy file lives (relative to the project folder)
DATA_DIR=data

# New accounts start with this many coins (created automatically when a member joins)
ECONOMY_STARTING_BALANCE=100
# Coins paid to each member in a voice channel every interval (0 = off).
# Bots, deafened members, the AFK channel and channels with fewer than MIN_HUMANS people earn nothing.
VOICE_PAY_AMOUNT=10
VOICE_PAY_INTERVAL_SECONDS=90
VOICE_PAY_MIN_HUMANS=2

# Yes votes needed for start_vote_timeout to pass
VOTE_TIMEOUT_MIN_VOTES=3

# Optional: generate_image tool (OpenAI)
# OPENAI_API_KEY=
# IMAGE_MODEL=gpt-image-1

# Music (music_* tools): install yt-dlp and ffmpeg on the host, or set absolute paths
# Keep yt-dlp updated: yt-dlp -U
# YTDLP_PATH=yt-dlp
# FFMPEG_PATH=ffmpeg
# YouTube client workaround (change if yt-dlp docs recommend newer clients)
# YTDLP_EXTRACTOR_ARGS=youtube:player_client=android,tv_embedded,visionos
# Optional: use logged-in browser cookies if anonymous YouTube keeps 403ing
# YTDLP_COOKIES_FROM_BROWSER=chrome

# CS tracker (cs_* tools): Discord ↔ many Steam accounts + multi-provider dossiers
# CSRep is the primary JSON API (apply for a key at csrep.gg). Others are best-effort.
# CSREP_API_KEY=
# FACEIT_API_KEY=
# STEAM_WEB_API_KEY=
# CSST_API_KEY=
# CSST_ENABLED=true
# CSTRACKER_ENABLED=true
# CS_CACHE_TTL_SECONDS=120
